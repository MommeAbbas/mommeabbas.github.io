---
import { getCollection } from 'astro:content';
import Entry from './Entry.astro';

const items = (await getCollection('research')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);
---

<section id="research">
  <h2>Research</h2>
  <ul class="entry-list">
    {items.map(({ data }) => <Entry {...data} />)}
  </ul>
</section>

<style>
  .entry-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
